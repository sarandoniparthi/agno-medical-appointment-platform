{
  "compilerOptions": {
    "composite": false,
    "declarationMap": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noUncheckedIndexedAccess": true,
    "strict": true,
    "target": "ES2023",
    "paths": {
      "@scheduler/contracts": ["./libs/contracts/src/index.ts"],
      "@scheduler/ui": ["./libs/ui/src/index.ts"],
      "@scheduler/auth": ["./libs/auth/src/index.ts"],
      "@scheduler/database": ["./libs/database/src/index.ts"],
      "@scheduler/observability": ["./libs/observability/src/index.ts"]
    }
  }
}
