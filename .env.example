POSTGRES_HOST_PORT=55432
POSTGRES_PASSWORD=scheduler-local-only
DATABASE_URL=postgresql://scheduler:scheduler-local-only@localhost:55432/scheduler
API_PORT=3000
WEB_PORT=4200
AGENT_HTTP_PORT=8000
AGENT_GRPC_PORT=50051
AGENT_GRPC_URL=127.0.0.1:50051
MCP_GATEWAY_PORT=8010
AWS_REGION=us-east-1
# BedrockSettings reads process environment only; local Nx serve targets load the root .env into it.
# Set exactly ONE model reference: BEDROCK_MODEL_ID or BEDROCK_INFERENCE_PROFILE_ARN.
# Leave the unused variable empty. BEDROCK_INFERENCE_PROFILE_ARN accepts an inference-profile ID or ARN.
# Credentials must use the ambient AWS provider chain: AWS CLI profile/SSO, IAM role, or workload identity.
# NEVER add AWS access keys, secret keys, or session tokens to this file.
# CI does not run the opt-in `nx run agent-runtime:bedrock-smoke` target by default.
BEDROCK_MODEL_ID=
BEDROCK_INFERENCE_PROFILE_ARN=
