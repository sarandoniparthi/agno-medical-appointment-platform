{
  "name": "runtime-foundation",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "nx": "nx",
    "build": "nx run-many -t build",
    "db:migrate": "tsx ./node_modules/typeorm/cli.js migration:run -d libs/database/src/lib/data-source.ts",
    "db:revert": "tsx ./node_modules/typeorm/cli.js migration:revert -d libs/database/src/lib/data-source.ts",
    "proto:generate": "node tools/generate-proto.mjs",
    "test": "nx run-many -t test && uv run pytest",
    "lint": "nx run-many -t lint && uv run ruff check . && uv run pyright",
    "verify": "npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@babel/core": "^7.14.5",
    "@babel/preset-react": "^7.14.5",
    "@eslint/js": "^9.8.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@nx/devkit": "23.1.1",
    "@nx/eslint": "^23.1.1",
    "@nx/eslint-plugin": "23.1.1",
    "@nx/js": "^23.1.1",
    "@nx/nest": "^23.1.1",
    "@nx/node": "^23.1.1",
    "@nx/playwright": "^23.1.1",
    "@nx/react": "^23.1.1",
    "@nx/vite": "^23.1.1",
    "@nx/vitest": "^23.1.1",
    "@nx/web": "23.1.1",
    "@nx/webpack": "23.1.1",
    "@playwright/test": "^1.37.0",
    "@swc/helpers": "~0.5.18",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "~4.1.0",
    "ajv": "^8.0.0",
    "eslint": "^9.8.0",
    "eslint-config-prettier": "^10.0.0",
    "jiti": "2.4.2",
    "jsdom": "^27.1.0",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "^23.1.1",
    "prettier": "^3.7.4",
    "tslib": "^2.3.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^5.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11",
    "webpack": "^5.101.3",
    "webpack-cli": "^7.0.0",
    "webpack-dev-server": "^5.2.1"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/typeorm": "^11.0.3",
    "axios": "^1.6.0",
    "pg": "^8.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "6.30.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "0.3.31"
  }
}
